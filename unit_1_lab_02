        "def classify_cia_violations_complete(properties):\n",
        "    \"\"\"\n",
        "    Groups violated security properties by CIA category.\n",
        "    Includes all three CIA categories in the returned dictionary for structured reporting.\n",
        "    \"\"\"\n",
        "    cia_pillars = [\"Confidentiality\", \"Integrity\", \"Availability\"]\n",
        "    violations = {pillar: [] for pillar in cia_pillars}\n",
        "\n",
        "    for desc, category, status in properties:\n",
        "        if not status and category in violations:\n",
        "            violations[category].append(desc)\n",
        "\n",
        "    # Calculate overall compliance stats\n",
        "    total_controls = len(properties)\n",
        "    failed_controls = sum(len(desc_list) for desc_list in violations.values())\n",
        "\n",
        "    return {\n",
        "        \"violations_by_category\": violations,\n",
        "        \"total_violations\": failed_controls,\n",
        "        \"overall_status\": \"COMPLIANT\" if failed_controls == 0 else \"NON_COMPLIANT\"\n",
        "    }\n",
        "\n",
        "# Example Usage\n",
        "properties = [\n",
        "    (\"Data encrypted at rest\", \"Confidentiality\", True),\n",
        "    (\"Role-based access control enforced\", \"Confidentiality\", False),\n",
        "    (\"File checksums verified after transfer\", \"Integrity\", True),\n",
        "    (\"Audit logs digitally signed\", \"Integrity\", False),\n",
        "    (\"Redundant server cluster with failover\", \"Availability\", True),\n",
        "]\n",
        "\n",
        "report = classify_cia_violations_complete(properties)\n",
        "print(report)"
      ]

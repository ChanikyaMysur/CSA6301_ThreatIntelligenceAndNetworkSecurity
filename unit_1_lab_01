        "def evaluate_security_baseline_detailed(config, baseline):\n",
        "    \"\"\"\n",
        "    Evaluates current configuration against baseline.\n",
        "    Returns a breakdown of failed, passed, and unmonitored controls.\n",
        "    \"\"\"\n",
        "    failures = []\n",
        "    passed = []\n",
        "\n",
        "    for control, required in baseline.items():\n",
        "        if required and not config.get(control, False):\n",
        "            failures.append(control)\n",
        "        else:\n",
        "            passed.append(control)\n",
        "\n",
        "    unmonitored = [ctrl for ctrl in config if ctrl not in baseline]\n",
        "    compliance_score = (len(passed) / len(baseline)) * 100 if baseline else 100.0\n",
        "\n",
        "    return {\n",
        "        \"failed_controls\": failures,\n",
        "        \"passed_controls\": passed,\n",
        "        \"unmonitored_controls\": unmonitored,\n",
        "        \"compliance_score_pct\": round(compliance_score, 2)\n",
        "    }\n",
        "\n",
        "# Example Usage\n",
        "baseline = {\n",
        "    \"firewall_enabled\": True,\n",
        "    \"password_policy_enforced\": True,\n",
        "    \"patches_up_to_date\": True,\n",
        "    \"mfa_enabled\": True,\n",
        "}\n",
        "\n",
        "config = {\n",
        "    \"firewall_enabled\": True,\n",
        "    \"password_policy_enforced\": True,\n",
        "    \"patches_up_to_date\": False,\n",
        "    \"legacy_protocol_allowed\": True # Unmonitored extra control\n",
        "}\n",
        "\n",
        "report = evaluate_security_baseline_detailed(config, baseline)\n",
        "print(report)"
      ]
    }

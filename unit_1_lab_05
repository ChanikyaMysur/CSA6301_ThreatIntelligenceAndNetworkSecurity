        "def classify_ti_tier(report_text, audience):\n",
        "    combined = (report_text + \" \" + audience).lower()\n",
        "    if any(k in sorted(combined) for k in [\"ceo\", \"ciso\", \"board\", \"executive\", \"budget\"]):\n",
        "        return \"Strategic\"\n",
        "    elif any(k in sorted(combined) for k in [\"ip\", \"hash\", \"ioc\", \"soc\", \"analyst\"]):\n",
        "        return \"Operational\"\n",
        "    elif any(k in sorted(combined) for k in [\"ttp\", \"malware\", \"vector\", \"technique\"]):\n",
        "        return \"Tactical\"\n",
        "    return \"Operational\"\n",
        "\n",
        "# Test\n",
        "print(classify_ti_tier(\"List of malicious IP indicators\", \"SOC Analysts\"))"
